// builtin module spec — katana crawl of a website / web page (depth 2).
// Follows hyperlinks and emits every discovered URL as a web page the target
// links to, keeping the full URL as the value so distinct paths stay distinct
// and any shared external URL converges across crawled sites.
// katana -jsonl nests the crawled URL at request.endpoint, so jq lifts it to
// a flat {url} per line (falling back to endpoint/url across versions) before
// ndjson reads it.
(
    id: "katana",
    label: "katana crawl",
    applies_to: ["domain", "website", "web_page"],
    bin: "sh",
    requires: ["katana", "jq"],
    args: ["-c", "katana -u '{value}' -jsonl -silent -d 2 | jq -c '{url: (.request.endpoint // .endpoint // .url)}'"],
    timeout_secs: 120,
    shapes: [
        (
            id: "katana",
            extract: (id: "ndjson"),
            min_hits: 1,
            emit: [
                Entity(from: "url", kind: "web_page", rel: "links_to"),
            ],
        ),
    ],
)

// builtin module spec — whois lookup for domains and IPs.
// Runs against the entity's typed value (falls back to label when it validates).
// Shapes are tried in order; first one clearing min_hits wins.
// No shape matching = raw output kept as evidence only, zero facts.
(
    id: "whois",
    label: "whois lookup",
    applies_to: ["domain", "ip_address"],
    bin: "whois",
    requires: [],
    args: ["{value}"],
    timeout_secs: 20,
    shapes: [
        // ICANN / Verisign style — domain registrations
        (
            id: "icann",
            extract: (id: "keyvalue", config: (sep: ":")),
            min_hits: 3,
            emit: [
                Attr(from: "registrar", key: "registrar"),
                Attr(from: "creation date", key: "registered_on"),
                Attr(from: "registry expiry date", key: "expires"),
                Attr(from: "dnssec", key: "dnssec"),
                Entity(from: "registrar", kind: "organization", rel: "registered_at"),
                Entity(from: "name server", kind: "server", rel: "resolves_to"),
            ],
        ),
        // RPSL — APNIC/RIPE style IP blocks
        (
            id: "rpsl",
            extract: (id: "keyvalue", config: (sep: ":", comments: "%")),
            min_hits: 3,
            emit: [
                Attr(from: "netname", key: "netname"),
                Attr(from: "inetnum", key: "range"),
                Entity(from: "org-name", kind: "organization", rel: "registered_at"),
                Entity(from: "abuse-mailbox", kind: "email", rel: "related_to"),
                Entity(from: "country", kind: "location", rel: "located_at", attrs: [
                    ("country", "country_code"),
                ]),
            ],
        ),
        // ARIN style IP blocks
        (
            id: "arin",
            extract: (id: "keyvalue", config: (sep: ":", comments: "#")),
            min_hits: 3,
            emit: [
                Attr(from: "netrange", key: "range"),
                Attr(from: "cidr", key: "cidr"),
                Entity(from: "orgname", kind: "organization", rel: "registered_at"),
                Entity(from: "country", kind: "location", rel: "located_at", attrs: [
                    ("country", "country_code"),
                    ("city", "city"),
                    ("stateprov", "region"),
                ]),
            ],
        ),
    ],
)
